                "mountPath": "/dev/shm",
                "name": "dshm",
              },
              {
                "mountPath": "/mnt/game-streamer",
                "name": "cache",
              },
            ],
          },
        ],
        "dnsConfig": {
          "options": [
            {
              "name": "ndots",
              "value": "1",
            },
          ],
        },
        "dnsPolicy": "ClusterFirstWithHostNet",
        "hostNetwork": true,
        "initContainers": [
          {
            "command": [
              "sh",
              "-c",
              "mkdir -p /mnt/game-streamer/steam /mnt/game-streamer/steamapps /mnt/game-streamer/demos /mnt/game-streamer/clips",
            ],
            "image": "busybox:1.36",
            "name": "prep-cache",
            "volumeMounts": [
              {
                "mountPath": "/mnt/game-streamer",
                "name": "cache",
              },
            ],
          },
        ],
        "restartPolicy": "Never",
        "runtimeClassName": "nvidia",
        "volumes": [
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "2Gi",
            },
