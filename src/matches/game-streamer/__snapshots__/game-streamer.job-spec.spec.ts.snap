          "app": "game-streamer",
          "match-id": "match-golden",
          "match-map-demo-id": "demo-golden",
          "match-map-id": "map-golden",
          "role": "batch-highlights",
        },
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "node-golden",
                      ],
                    },
                  ],
                },
              ],
            },
          },
        },
        "containers": [
          {
            "args": [
              "batch-highlights",
            ],
            "env": [
              {
                "name": "MATCH_ID",
                "value": "match-golden",
              },
              {
                "name": "DISPLAY_SIZEW",
                "value": "1920",
              },
              {
                "name": "DISPLAY_SIZEH",
                "value": "1080",
              },
              {
                "name": "API_BASE",
                "value": "http://api:5585",
              },
              {
                "name": "STEAM_USER",
                "value": "golden-bot",
              },
              {
                "name": "STEAM_PASSWORD",
                "value": "golden-pw",
              },
              {
                "name": "BATCH_MATCH_MAP_ID",
                "value": "map-golden",
              },
            ],
            "image": "5stack/game-streamer:golden",
            "imagePullPolicy": "Always",
            "name": "batch",
            "ports": [
              {
                "containerPort": 1350,
                "name": "spec",
              },
            ],
            "resources": {
              "limits": {
                "memory": "16Gi",
                "nvidia.com/gpu": "1",
              },
              "requests": {
                "memory": "8Gi",
                "nvidia.com/gpu": "1",
              },
            },
