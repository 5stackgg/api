exports[`GameStreamerService Job spec goldens AMD profile amd batch-highlights 1`] = `
{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "labels": {
      "5stack-gpu-vendor": "amd",
      "app": "game-streamer",
      "match-id": "match-golden",
      "match-map-demo-id": "demo-golden",
      "match-map-id": "map-golden",
      "role": "batch-highlights",
    },
    "name": "gs-batch-mapgolde-demogold",
  },
  "spec": {
    "backoffLimit": 0,
    "template": {
      "metadata": {
        "labels": {
          "5stack-gpu-vendor": "amd",
          "app": "game-streamer",
          "match-id": "match-golden",
          "match-map-demo-id": "demo-golden",
          "match-map-id": "map-golden",
          "role": "batch-highlights",
        },
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "node-golden",
                      ],
                    },
                  ],
                },
              ],
            },
          },
        },
        "containers": [
          {
            "args": [
              "batch-highlights",
            ],
            "env": [
              {
                "name": "MATCH_ID",
                "value": "match-golden",
              },
              {
                "name": "DISPLAY_SIZEW",
                "value": "1920",
              },
              {
                "name": "DISPLAY_SIZEH",
                "value": "1080",
              },
              {
                "name": "API_BASE",
                "value": "http://api:5585",
              },
              {
                "name": "STEAM_USER",
                "value": "golden-bot",
              },
              {
                "name": "STEAM_PASSWORD",
                "value": "golden-pw",
              },
              {
                "name": "BATCH_MATCH_MAP_ID",
                "value": "map-golden",
              },
              {
                "name": "GS_GPU_VENDOR",
                "value": "amd",
              },
              {
                "name": "GS_GPU_PCI_ADDRESS",
                "value": "0000:c4:00.0",
              },
            ],
            "image": "5stack/game-streamer:golden",
            "imagePullPolicy": "Always",
            "name": "batch",
            "ports": [
              {
                "containerPort": 1350,
                "name": "spec",
              },
            ],
            "resources": {
              "limits": {
                "memory": "16Gi",
              },
              "requests": {
                "memory": "8Gi",
              },
            },
            "securityContext": {
              "privileged": true,
            },
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "dshm",
              },
              {
                "mountPath": "/mnt/game-streamer",
                "name": "cache",
              },
            ],
          },
        ],
        "dnsConfig": {
          "options": [
            {
              "name": "ndots",
              "value": "1",
            },
          ],
        },
        "dnsPolicy": "ClusterFirstWithHostNet",
        "hostNetwork": true,
        "initContainers": [
          {
            "command": [
              "sh",
              "-c",
              "mkdir -p /mnt/game-streamer/steam /mnt/game-streamer/steamapps /mnt/game-streamer/demos /mnt/game-streamer/clips",
            ],
            "image": "busybox:1.36",
            "name": "prep-cache",
            "volumeMounts": [
              {
                "mountPath": "/mnt/game-streamer",
                "name": "cache",
              },
            ],
          },
        ],
        "restartPolicy": "Never",
        "volumes": [
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "2Gi",
            },
            "name": "dshm",
          },
          {
            "hostPath": {
              "path": "/opt/5stack/game-streamer",
              "type": "DirectoryOrCreate",
            },
            "name": "cache",
          },
        ],
      },
    },
    "ttlSecondsAfterFinished": 86400,
  },
}
`;

